# Copy to .env and fill in real values

# ── Docker service passwords (change these for any non-local deployment) ──────
POSTGRES_PASSWORD=newspass
NEO4J_PASSWORD=newspass123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://news:newspass@localhost:5432/newsdb

# ClickHouse
CLICKHOUSE_HOST=localhost

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=newspass123

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (local dev uses MinIO)
S3_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=news-raw
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Vector store (leave blank to use local FAISS)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-aws
USE_FAISS_LOCAL=true

# Reddit API (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Twitter/X API v2 (optional)
TWITTER_BEARER_TOKEN=

# OpenAI (optional — RAG + insights use this)
OPENAI_API_KEY=

# Crawl settings
CRAWL_INTERVAL_SECONDS=120
MAX_CONCURRENT_CRAWLERS=25

# Proxy rotation — add proxies to avoid IP bans on web crawling
# Format: http://user:pass@host:port  (one per line, comma-separated in code)
# Leave empty to use your direct IP (fine for RSS, risky for web crawling)
# PROXY_LIST=http://proxy1:port,http://proxy2:port
